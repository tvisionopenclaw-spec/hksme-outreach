# Copy this file to secrets.toml LOCALLY (not committed) for local testing
# For Streamlit Cloud: paste these into Settings → Secrets in the cloud UI
# DO NOT commit secrets.toml to GitHub (already in .gitignore)

# Password to access the portal (set a strong one)
PORTAL_PASSWORD = "change-this-to-a-strong-password"

# Required: lead discovery
APIFY_TOKEN = "apify_api_xxxxxxxxxxxxxxxxxxxxx"
GEMINI_API_KEY = "AIzaSyXxxxxxxxxxxxxxxxxxxx"

# Optional: email bulk send
RESEND_API_KEY = "re_xxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL = "onboarding@resend.dev"
RESEND_FROM_NAME = "Your Name - TVision"

# Optional: gmail send (alternative to Resend)
# GMAIL_ADDRESS = "your.email@gmail.com"
# GMAIL_APP_PASSWORD = "xxxxxxxxxxxxxxxx"
# GMAIL_SENDER_NAME = "Your Name - TVision"

EMAIL_DELAY_SECONDS = "5"
