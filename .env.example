# Copy this to .env and fill in. .env is gitignored.
# Skill reads from ~/.claude/skills/hksme-cold-outreach/.env

# === Lead discovery ===
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyXxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Email bulk send — pick ONE provider ===

# Option A: Resend (Recommended — 2 min setup, 100/day free, 3000/month)
# Get key: https://resend.com → Sign in → API Keys → Create API Key
# For testing, use onboarding@resend.dev (no domain verification needed)
# For production, verify your domain at https://resend.com/domains
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Your Name - TVision

# Option B: Gmail SMTP (free 500/day, but needs App Password setup)
# Get App Password: https://myaccount.google.com/apppasswords (needs 2FA on)
# GMAIL_ADDRESS=your.business@gmail.com
# GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# GMAIL_SENDER_NAME=Your Name - TVision

# Delay between sends (seconds) — applies to both providers
EMAIL_DELAY_SECONDS=5
